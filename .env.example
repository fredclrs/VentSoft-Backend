# Copiá este archivo a .env (mismo directorio) y completá los valores antes de
# correr "docker compose up". El .env real NUNCA se sube a ningún repositorio.

# Contraseña del usuario "sa" de SQL Server. SQL Server la rechaza si es débil:
# mínimo 8 caracteres, y de estos 4 grupos (mayúscula, minúscula, número, símbolo)
# tiene que tener de al menos 3.
MSSQL_SA_PASSWORD=

# Usuario y contraseña dedicados que usa la API para conectarse a la base (no es
# "sa" — se crea solo la primera vez que se levanta, con permisos acotados a
# lectura/escritura sobre la base VentSoft nomás).
APP_DB_USER=ventsoft_app
APP_DB_PASSWORD=

# Clave para firmar los tokens JWT de sesión: cualquier cadena larga y aleatoria
# (32+ caracteres). Cambiarla invalida todas las sesiones activas.
JWT_KEY=

# Dominio público por el que se accede a la app por HTTPS. Caddy le pide un
# certificado real y gratis a Let's Encrypt para este nombre, automático.
# Sin dominio propio: usá "<tu-ip-con-guiones>.sslip.io", ej. si tu servidor es
# 147.182.140.124, poné SITE_DOMAIN=147-182-140-124.sslip.io
SITE_DOMAIN=
